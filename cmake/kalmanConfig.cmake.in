@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# Eigen 3.4 or 5.x. Two lookups, because Eigen 3.4's version file rejects
# a range spanning major versions.
find_package(Eigen3 3.4 QUIET NO_MODULE)
if(NOT Eigen3_FOUND)
    find_dependency(Eigen3 5 NO_MODULE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/kalmanTargets.cmake")
check_required_components(kalman)
